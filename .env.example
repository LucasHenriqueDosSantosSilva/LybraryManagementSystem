# Copy to .env and set two distinct private passwords. Never commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=library
FRONTEND_PORT=8088
LIBRARY_TIME_ZONE=America/Sao_Paulo
LIBRARY_LOAN_DAYS=14

LIBRARY_ADMIN_USERNAME=bibliotecario
LIBRARY_ADMIN_PASSWORD=
# true only with HTTPS on the browser origin
LIBRARY_COOKIE_SECURE=false

LIBRARY_LOGIN_LIMIT=10
LIBRARY_LOGIN_WINDOW_SECONDS=60
# Optional HTTPS overlay: provision this external certificate volume first
TLS_VOLUME=
HTTPS_PORT=8443
